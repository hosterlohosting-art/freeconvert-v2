# Apache / cPanel Configuration for freeconvert.cloud

# 1. Prevent Directory Listing (Security)
Options -Indexes

# 2. Force UTF-8 Encoding
AddDefaultCharset UTF-8
AddType application/manifest+json .webmanifest
AddType text/plain .txt

# 3. Enable Gzip Compression (Optimizes Core Web Vitals)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 4. Configure Expires Headers (Aggressive Browser Caching for Speed)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/manifest+json "access plus 1 week"
</IfModule>

# 4b. Keep internal templates and non-content files out of search indexes
<IfModule mod_headers.c>
  <FilesMatch "(tool-template|blog-template)\.html$">
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
</IfModule>

# 5. URL Rewrite Policies (SSL force & SEO trailing slashes)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 301 Redirects for Google Search Console 404 / Crawled Exclusions
  Redirect 301 /Image-resizer/ https://freeconvert.cloud/image-resizer/
  Redirect 301 /about-freeconvert/ https://freeconvert.cloud/about/
  Redirect 301 /contact-us/ https://freeconvert.cloud/contact/
  Redirect 301 /2025/12/18/qr-codes-on-business-cards/ https://freeconvert.cloud/blog/
  Redirect 301 /2025/11/02/hello-world/ https://freeconvert.cloud/blog/
  Redirect 301 /blog/hub-pages/online-timer-with-alarm.html https://freeconvert.cloud/stopwatch/
  Redirect 301 /blog/hub-pages/markdown-editor-with-real-time-preview.html https://freeconvert.cloud/markdown-editor/
  Redirect 301 /blog/hub-pages/lorem-ipsum-generator-for-ui-design.html https://freeconvert.cloud/lorem-ipsum/
  Redirect 301 /blog/hub-pages/convert-json-to-excel-csv.html https://freeconvert.cloud/blog/how-to-convert-json-to-csv-for-spreadsheets/

  # A. Redirect Non-HTTPS to HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://freeconvert.cloud/$1 [R=301,L]

  # B. Redirect WWW to Non-WWW (Canonical domain: https://freeconvert.cloud/)
  RewriteCond %{HTTP_HOST} ^www\.freeconvert\.cloud [NC]
  RewriteRule ^(.*)$ https://freeconvert.cloud/$1 [R=301,L]

  # C. Force trailing slashes on all dynamic folders to match sitemap / canonical paths
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ https://freeconvert.cloud/$1/ [R=301,L]
</IfModule>
