# Apache / cPanel Configuration for freeconvert.cloud

# 1. Prevent Directory Listing (Security)
Options -Indexes

# 2. Force UTF-8 Encoding
AddDefaultCharset UTF-8

# 3. Enable Gzip Compression (Optimizes Core Web Vitals)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# 4. Configure Expires Headers (Aggressive Browser Caching for Speed)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# 5. URL Rewrite Policies (SSL force & SEO trailing slashes)
<IfModule mod_rewrite.c>
  RewriteEngine On

  # A. Redirect Non-HTTPS to HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://freeconvert.cloud/$1 [R=301,L]

  # B. Redirect WWW to Non-WWW (Canonical domain: https://freeconvert.cloud/)
  RewriteCond %{HTTP_HOST} ^www\.freeconvert\.cloud [NC]
  RewriteRule ^(.*)$ https://freeconvert.cloud/$1 [R=301,L]

  # C. Force trailing slashes on all dynamic folders to match sitemap / canonical paths
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ https://freeconvert.cloud/$1/ [R=301,L]
</IfModule>
